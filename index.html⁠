            {
                question: "أي مما يلي يعتبر من أعراف الكتابة الأساسية؟",
                options: ["العناوين الرئيسية والجانبية", "التظليل والتلوين فقط", "وضع الغلاف الخارجي"],
                correct: 0
            },
            {
                question: "الهدف الرئيسي من مرحلة (أجب) في القراءة المتعمقة هو:",
                options: ["تصفح الفهرس", "إجابة الأسئلة من الذاكرة لترسيخ الفهم", "قراءة الكتاب جهرةً"],
                correct: 1
            }
        ];

        // Functions for Tab Navigation
        function switchTab(tabName) {
            ['home', 'lessons', 'practice', 'exam'].forEach(tab => {
                document.getElementById(`section-${tab}`).classList.add('hidden');
                document.getElementById(`tab-${tab}`).classList.remove('tab-active');
            });
            document.getElementById(`section-${tabName}`).classList.remove('hidden');
            document.getElementById(`tab-${tabName}`).classList.add('tab-active');
        }

        // Accordion Toggle
        function toggleAccordion(id) {
            const el = document.getElementById(id);
            el.classList.toggle('hidden');
        }

        // Render Practice Questions
        function renderPractice() {
            const container = document.getElementById('practice-container');
            container.innerHTML = '';

            practiceData.forEach((q, idx) => {
                const card = document.createElement('div');
                card.className = "bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm space-y-3";
                
                let optionsHtml = '';
                q.options.forEach((opt, oIdx) => {
                    optionsHtml += `
                        <button onclick="checkPractice(${idx}, ${oIdx})" id="practice-opt-${idx}-${oIdx}" class="w-full text-right p-3 rounded-xl border border-slate-200 hover:bg-slate-50 transition text-xs sm:text-sm font-medium flex items-center justify-between">
                            <span>${opt}</span>
                            <i class="fa-regular fa-circle text-slate-300"></i>
                        </button>
                    `;
                });

                card.innerHTML = `
                    <h4 class="font-bold text-slate-800 text-sm sm:text-base">${idx + 1}. ${q.question}</h4>
                    <div class="space-y-2">${optionsHtml}</div>
                    <div id="practice-exp-${idx}" class="hidden p-3 rounded-xl bg-slate-50 border border-slate-200 text-xs text-slate-600 mt-2"></div>
                `;
                container.appendChild(card);
            });
        }

        // Check Practice Answer
        function checkPractice(qIdx, selectedOpt) {
            const q = practiceData[qIdx];
            const expEl = document.getElementById(`practice-exp-${qIdx}`);

            for (let i = 0; i < q.options.length; i++) {
                const btn = document.getElementById(`practice-opt-${qIdx}-${i}`);
                btn.disabled = true;
                if (i === q.correct) {
                    btn.classList.add('bg-emerald-50', 'border-emerald-500', 'text-emerald-800');
                } else if (i === selectedOpt) {
                    btn.classList.add('bg-rose-50', 'border-rose-400', 'text-rose-800');
                }
            }

            expEl.classList.remove('hidden');
            if (selectedOpt === q.correct) {
                expEl.innerHTML = `<span class="text-emerald-700 font-bold block mb-0.5">إجابة صحيحة ممتاز! 👏</span> ${q.explanation}`;
                triggerFireworks();
                showSuccessToast('أحسنت يا ناصر!', 'إجابتك صحيحة ودقيقة جداً 👍');
            } else {
                expEl.innerHTML = `<span class="text-rose-600 font-bold block mb-0.5">إجابة خاطئة!</span> ${q.explanation}`;
            }
        }

        // Exam State Variables
        let currentExamIdx = 0;
        let examScore = 0;

        function startExam() {
            currentExamIdx = 0;
            examScore = 0;
            document.getElementById('exam-start-screen').classList.add('hidden');
            document.getElementById('exam-result-screen').classList.add('hidden');
            document.getElementById('exam-screen').classList.remove('hidden');
            showExamQuestion();
        }

        function showExamQuestion() {
            const q = examQuestions[currentExamIdx];
            document.getElementById('exam-question-title').innerText = `${currentExamIdx + 1}. ${q.question}`;
            document.getElementById('exam-progress-text').innerText = `السؤال ${currentExamIdx + 1} من ${examQuestions.length}`;
            document.getElementById('exam-progress-bar').style.width = `${((currentExamIdx + 1) / examQuestions.length) * 100}%`;

            const container = document.getElementById('exam-options-container');
            container.innerHTML = '';

            q.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = "w-full text-right p-3.5 rounded-xl border border-slate-200 hover:bg-blue-50 hover:border-blue-300 transition text-sm font-medium";
                btn.innerText = opt;
                btn.onclick = () => handleExamAnswer(idx);
                container.appendChild(btn);
            });
        }

        function handleExamAnswer(selectedOpt) {
            if (selectedOpt === examQuestions[currentExamIdx].correct) {
                examScore++;
                triggerFireworks();
            }

            currentExamIdx++;
            if (currentExamIdx < examQuestions.length) {
                showExamQuestion();
            } else {
                finishExam();
            }
        }

        function finishExam() {
            document.getElementById('exam-screen').classList.add('hidden');
            document.getElementById('exam-result-screen').classList.remove('hidden');
            document.getElementById('exam-score-text').innerText = `${examScore} / ${examQuestions.length}`;

            const feedback = document.getElementById('exam-feedback');
            if (examScore === examQuestions.length) {
                feedback.innerText = "ما شاء الله! درجة كاملة وأداء استثنائي رائع 🎉";
                triggerFireworks();
            } else if (examScore >= 3) {
                feedback.innerText = "أداء ممتاز جداً! واصل المراجعة لتقوية حصيلتك ✨";
            } else {
                feedback.innerText = "حاول مرة أخرى واقرأ الشروحات بعناية للوصول للدرجة الكاملة 👍";
            }
        }

        // Trigger Fireworks / Confetti
        function triggerFireworks() {
            confetti({
                particleCount: 70,
                spread: 60,
                origin: { y: 0.7 }
            });
        }

        // Show Toast Notification
        function showSuccessToast(title, message) {
            const toast = document.getElementById('success-toast');
            document.getElementById('toast-title').innerText = title;
            document.getElementById('toast-message').innerText = message;

            toast.classList.remove('translate-y-32');
            setTimeout(() => {
                toast.classList.add('translate-y-32');
            }, 3000);
        }

        // Initialize App
        window.onload = () => {
            renderPractice();
        };
    </script>
</body>
</html>
